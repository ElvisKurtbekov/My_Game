--- !u!114 &4289015073406401724
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2804379747005362820}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e26c35668894c7b4291dcbc928bb09c4, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  npcLine: "\u041F\u0440\u0438\u0432\u0435\u0442! \u0414\u043E\u0431\u0440\u043E
    \u043F\u043E\u0436\u0430\u043B\u043E\u0432\u0430\u0442\u044C \u0432 \u0441\u0430\u043C\u043E\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C\u043D\u0443\u044E
    \u0436\u0438\u0437\u043D\u044C! \n\u0422\u0435\u043F\u0435\u0440\u044C \u0442\u044B
    \u0441\u0430\u043C \u0440\u0435\u0448\u0430\u0435\u0448\u044C, \u0433\u0434\u0435
    \u0436\u0438\u0442\u044C, \u043A\u0430\u043A \u0437\u0430\u0440\u0430\u0431\u0430\u0442\u044B\u0432\u0430\u0442\u044C
    \u0434\u0435\u043D\u044C\u0433\u0438 \u0438 \u043D\u0430 \u0447\u0442\u043E \u0438\u0445
    \u0442\u0440\u0430\u0442\u0438\u0442\u044C. \u042D\u0442\u043E \u043D\u0435\u043B\u0435\u0433\u043A\u043E,
    \u043D\u043E \u043D\u0435 \u043F\u0435\u0440\u0435\u0436\u0438\u0432\u0430\u0439
    \u2013 \u044F \u043F\u043E\u043C\u043E\u0433\u0443 \u0442\u0435\u0431\u0435 \u043E\u0441\u0432\u043E\u0438\u0442\u044C\u0441\u044F.
    \u0413\u043E\u0442\u043E\u0432 \u043D\u0430\u0447\u0430\u0442\u044C \u0441\u0432\u043E\u0439
    \u043F\u0443\u0442\u044C?"
  playerChoices:
  - "\u0414\u0430, \u044F \u0433\u043E\u0442\u043E\u0432! \u0413\u0434\u0435 \u043C\u043D\u0435
    \u043D\u0430\u0447\u0430\u0442\u044C?"
  - "\u041D\u0435 \u0437\u043D\u0430\u044E... \u044D\u0442\u043E \u0432\u0441\u0435
    \u0437\u0432\u0443\u0447\u0438\u0442 \u0441\u043B\u043E\u0436\u043D\u043E."
  npcResponses:
  - responses:
    - "\u041E\u0442\u043B\u0438\u0447\u043D\u043E, \u044F \u0432\u0438\u0436\u0443,
      \u0447\u0442\u043E \u043D\u0430\u043A\u043E\u043F\u043B\u0435\u043D\u0438\u044F
      \u0443 \u0442\u0435\u0431\u044F \u043E\u0441\u0442\u0430\u043B\u0438\u0441\u044C. "
    - "\u041F\u0435\u0440\u0432\u044B\u043C \u0434\u0435\u043B\u043E\u043C \u0442\u0435\u0431\u0435
      \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E \u0441\u0445\u043E\u0434\u0438\u0442\u044C
      \u0432 \u043C\u0430\u0433\u0430\u0437\u0438\u043D \u0438 \u043A\u0443\u043F\u0438\u0442\u044C
      \u043F\u0440\u043E\u0434\u0443\u043A\u0442\u044B."
  - responses:
    - "\u041D\u0435 \u043F\u0435\u0440\u0435\u0436\u0438\u0432\u0430\u0439, \u044D\u0442\u043E
      \u0432\u043F\u043E\u043B\u043D\u0435 \u0435\u0441\u0442\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E.
      \u041C\u044B \u043D\u0430\u0447\u043D\u0435\u043C \u0441 \u043F\u0440\u043E\u0441\u0442\u044B\u0445
      \u0448\u0430\u0433\u043E\u0432."
    - "\u041F\u0435\u0440\u0432\u044B\u043C \u0434\u0435\u043B\u043E\u043C \u0442\u0435\u0431\u0435
      \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E \u0441\u0445\u043E\u0434\u0438\u0442\u044C
      \u0432 \u043C\u0430\u0433\u0430\u0437\u0438\u043D \u0438 \u043A\u0443\u043F\u0438\u0442\u044C
      \u043F\u0440\u043E\u0434\u0443\u043A\u0442\u044B."
  interactionHint: {fileID: 0}
  assignedQuest:
    title: "\u041F\u0435\u0440\u0432\u043E\u0435 \u0437\u0430\u0434\u0430\u043D\u0438\u0435"
    description: "\u041D\u0430\u0439\u0442\u0438 \u0436\u0438\u043B\u044C\u0435"
    isCompleted: 0
    progress: 0
  taskResult: {fileID: 2881937693830942956}
  questComplete: {fileID: 473119353684976319}
